# Copy to .env (docker compose) or backend/.env (local run)

# --- local run without Docker (SQLite, no Redis, local files) ---
# DATABASE_URL=sqlite:///./kpi_hub.db
# CELERY_ALWAYS_EAGER=true
# LOCAL_STORAGE_DIR=./storage

# Scheduled consolidation interval for Celery beat (minutes)
CONSOLIDATION_SCHEDULE_MINUTES=60

# --- AI (optional). Leave LLM_PROVIDER=none for deterministic rule-based commentary ---
LLM_PROVIDER=none
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

MAX_UPLOAD_MB=20
